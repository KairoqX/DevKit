# Copy this file to .env.local for local development.
# On Vercel, add names under Project -> Settings -> Environment Variables, then redeploy.
# All of these are optional: the site already defaults to https://vexiqora.vercel.app.

# Only set this if the site moves to a different domain (with https:// and no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://vexiqora.vercel.app

# If set, the Contact page shows this address and the page is added to the sitemap.
# NEXT_PUBLIC_CONTACT_EMAIL=

# The code from Google Search Console's "HTML tag" verification method (just the content value).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
